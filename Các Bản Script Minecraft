    end)
end

-- Loyalty bay về người chơi
local function ReturnTrident()
    if not asset then
        return
    end

    if not HasLanded then
        return
    end

    if asset.Parent ~= workspace then
        return
    end

    local Character = player.Character

    if not Character then
        return
    end

    local RootPart = Character:FindFirstChild("HumanoidRootPart")

    if not RootPart then
        return
    end

    local handle = asset:FindFirstChild("Handle")

    if not handle then
        return
    end

    if LoyaltyConnection then
        LoyaltyConnection:Disconnect()
        LoyaltyConnection = nil
    end

    -- Sound phát đúng lúc bắt đầu Return
    PlayReturnSound(handle)

    HasLanded = false

    handle.Anchored = true
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false

    LoyaltyConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if not handle or not handle.Parent then
            LoyaltyConnection:Disconnect()
            LoyaltyConnection = nil
            return
        end

        local CurrentCharacter = player.Character

        if not CurrentCharacter then
            return
        end

        local CurrentRoot = CurrentCharacter:FindFirstChild("HumanoidRootPart")

        if not CurrentRoot then
            return
        end

        local TargetPosition = CurrentRoot.Position
        local Difference = TargetPosition - handle.Position
        local Distance = Difference.Magnitude

        -- Đã bay tới người chơi
        if Distance <= 3 then
            LoyaltyConnection:Disconnect()
            LoyaltyConnection = nil

            asset:Destroy()
            asset = nil

            HasThrown = false
            HasLanded = false

            -- Trả Tool về Backpack
            tool.Parent = player:WaitForChild("Backpack")

            return
        end

        local ReturnDirection = Difference.Unit
        local NewPosition = handle.Position + ReturnDirection * LoyaltySpeed * DeltaTime

        handle.CFrame = CFrame.lookAt(NewPosition, NewPosition + ReturnDirection) * LoyaltyRotation
    end)
end

-- Riptide phóng nhân vật về vị trí đã bấm
local function RiptideTrident()
    local Character = player.Character

    if not Character then
        return
    end

    local RootPart = Character:FindFirstChild("HumanoidRootPart")

    if not RootPart then
        return
    end

    local TargetPosition = Mouse.Hit.Position
    local Difference = TargetPosition - RootPart.Position

    if Difference.Magnitude <= 0 then
        return
    end

    local Direction = Difference.Unit

    -- Âm thanh Riptide random
    local RiptideSound1 = "rbxassetid://137007036913527"
    local RiptideSound2 = "rbxassetid://140096522484381"
    local RiptideSound = Instance.new("Sound")

    if math.random(1, 2) == 1 then
        RiptideSound.SoundId = RiptideSound1
    else
        RiptideSound.SoundId = RiptideSound2
    end

    RiptideSound.Volume = 1
    RiptideSound.Parent = RootPart
    RiptideSound:Play()

    RiptideSound.Ended:Connect(function()
        RiptideSound:Destroy()
    end)

    RootPart.AssemblyLinearVelocity = Direction * RiptideSpeed

    -- Riptide Spin
    for _, Object in pairs(RootPart:GetChildren()) do
        if Object.Name == "Spinning" then
            Object:Destroy()
        end
    end

    if RiptideSpeedSpin ~= 0 and RiptideSpinTime > 0 then
        local Spin = Instance.new("BodyAngularVelocity")
        Spin.Name = "Spinning"
        Spin.Parent = RootPart
        Spin.MaxTorque = Vector3.new(0, math.huge, 0)
        Spin.AngularVelocity = Vector3.new(0, RiptideSpeedSpin, 0)

        task.delay(RiptideSpinTime, function()
            if Spin and Spin.Parent == RootPart then
                Spin:Destroy()
            end
        end)
    end
end

-- Phóng Trident
local function ThrowTrident()
    if not asset then
        return
    end

    if HasLanded then
        return
    end

    local Character = player.Character

    if not Character then
        return
    end

    local RightArm = Character:FindFirstChild("RightUpperArm") or Character:FindFirstChild("Right Arm")

    if not RightArm then
        return
    end

    local handle = asset:FindFirstChild("Handle")

    if not handle then
        return
    end

    local Direction = Mouse.Hit.Position - handle.Position

    if Direction.Magnitude <= 0 then
        return
    end

    Direction = Direction.Unit

    -- Âm thanh phóng random
    local ThrowSound1 = "rbxassetid://127288802636114"
    local ThrowSound2 = "rbxassetid://132224047607007"
    local ThrowSound = Instance.new("Sound")

    if math.random(1, 2) == 1 then
        ThrowSound.SoundId = ThrowSound1
    else
        ThrowSound.SoundId = ThrowSound2
    end

    ThrowSound.Volume = 1
    ThrowSound.Parent = handle
    ThrowSound:Play()

    ThrowSound.Ended:Connect(function()
        ThrowSound:Destroy()
    end)

    -- Tách Trident khỏi tay
    for _, Object in ipairs(handle:GetChildren()) do
        if Object:IsA("Motor6D") then
            Object:Destroy()
        end
    end

    asset.Parent = workspace
    HasThrown = true

    handle.Anchored = true
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false

    if PhysicsConnection then
        PhysicsConnection:Disconnect()
        PhysicsConnection = nil
    end

    local CurrentPosition = handle.Position
    local Velocity = Direction * ThrowSpeed

    local RaycastParams = RaycastParams.new()
    RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    RaycastParams.FilterDescendantsInstances = {
        Character,
        asset
    }

    PhysicsConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if not handle or not handle.Parent then
            PhysicsConnection:Disconnect()
            PhysicsConnection = nil
            return
        end

        local PreviousPosition = CurrentPosition

        -- Trọng lực
        Velocity += Vector3.new(0, -workspace.Gravity, 0) * DeltaTime

        local NewPosition = CurrentPosition + Velocity * DeltaTime
        local RayDirection = NewPosition - PreviousPosition

        local Result = workspace:Raycast(PreviousPosition, RayDirection, RaycastParams)

        if Result then
            CurrentPosition = Result.Position

            local ImpactDirection = Velocity

            if ImpactDirection.Magnitude > 0 then
                ImpactDirection = ImpactDirection.Unit
            else
                ImpactDirection = Direction
            end

            handle.CFrame = CFrame.lookAt(CurrentPosition, CurrentPosition + ImpactDirection)

            -- Kiểm tra Player / NPC
            local HitCharacter = Result.Instance:FindFirstAncestorOfClass("Model")
            local HitPlayer = HitCharacter and Players:GetPlayerFromCharacter(HitCharacter)
            local HitHumanoid = HitCharacter and HitCharacter:FindFirstChildOfClass("Humanoid")

            if HitPlayer or HitHumanoid then
                -- Pierce Sound
                local Pierce1 = "rbxassetid://128968057279479"
                local Pierce2 = "rbxassetid://86338171355237"
                local PierceSound = Instance.new("Sound")

                if math.random(1, 2) == 1 then
                    PierceSound.SoundId = Pierce1
                else
                    PierceSound.SoundId = Pierce2
                end

                PierceSound.Volume = 1
                PierceSound.Parent = handle
                PierceSound:Play()

                PierceSound.Ended:Connect(function()
                    PierceSound:Destroy()
                end)

                RaycastParams.FilterDescendantsInstances = {
                    Character,
                    asset,
                    HitCharacter
                }

                -- Văng ngược
                local BackDirection = -ImpactDirection

                local RandomOffset = Vector3.new(
                    math.random(-35, 35) / 100,
                    math.random(-15, 20) / 100,
                    math.random(-35, 35) / 100
                )

                local BounceDirection = (BackDirection + RandomOffset).Unit

                Velocity = BounceDirection * ThrowSpeed
                CurrentPosition = CurrentPosition + BounceDirection * 0.2

                handle.CFrame = CFrame.lookAt(
                    CurrentPosition,
                    CurrentPosition + BounceDirection
                )

                return
            end

            -- Impact Sound
            local ImpactSound1 = "rbxassetid://93112074394408"
            local ImpactSound2 = "rbxassetid://122893311840943"
            local ImpactSound = Instance.new("Sound")

            if math.random(1, 2) == 1 then
                ImpactSound.SoundId = ImpactSound1
            else
                ImpactSound.SoundId = ImpactSound2
            end

            ImpactSound.Volume = 1
            ImpactSound.Parent = handle
            ImpactSound:Play()

            ImpactSound.Ended:Connect(function()
                ImpactSound:Destroy()
            end)

            -- Dừng và cắm Trident
            Velocity = Vector3.zero

            handle.Anchored = true
            handle.CanCollide = true
            handle.CanTouch = true
            handle.CanQuery = true

            HasLanded = true

            PhysicsConnection:Disconnect()
            PhysicsConnection = nil

            -- Loyalty
            if string.upper(tostring(Loyalty)) == "ON" then
                if LoyaltyReturnTime > 0 then
                    task.delay(LoyaltyReturnTime, function()
                        if asset and asset.Parent == workspace and HasLanded then
                            ReturnTrident()
                        end
                    end)
                else
                    -- Time = 0
                    -- Return ngay
                    ReturnTrident()
                end
            end

            return
        end

        CurrentPosition = NewPosition

        if Velocity.Magnitude > 0 then
            handle.CFrame = CFrame.lookAt(
                CurrentPosition,
                CurrentPosition + Velocity.Unit
            )
        else
            handle.Position = CurrentPosition
        end
    end)

    -- Xóa Tool khỏi Backpack
    tool.Parent = nil
end

-- Nhặt lại Trident bằng click
local function PickupTrident()
    if not asset then
        return
    end

    if not HasLanded then
        return
    end

    if asset.Parent ~= workspace then
        return
    end

    local handle = asset:FindFirstChild("Handle")

    if not handle then
        return
    end

    if PhysicsConnection then
        PhysicsConnection:Disconnect()
        PhysicsConnection = nil
    end

    if LoyaltyConnection then
        LoyaltyConnection:Disconnect()
        LoyaltyConnection = nil
    end

    asset:Destroy()
    asset = nil

    HasLanded = false
    HasThrown = false

    -- Chỉ đưa Tool về Backpack
    tool.Parent = player:WaitForChild("Backpack")
end

-- Click để nhặt Trident
Mouse.Button1Down:Connect(function()
    if not asset then
        return
    end

    if not HasLanded then
        return
    end

    if asset.Parent ~= workspace then
        return
    end

    local Target = Mouse.Target

    if Target and Target:IsDescendantOf(asset) then
        PickupTrident()
    end
end)

-- Xóa Tài nguyên
local function removeAsset()
    if HasThrown then
        return
    end

    if PhysicsConnection then
        PhysicsConnection:Disconnect()
        PhysicsConnection = nil
    end

    if LoyaltyConnection then
        LoyaltyConnection:Disconnect()
        LoyaltyConnection = nil
    end

    if asset then
        asset:Destroy()
        asset = nil
    end

    HasLanded = false
end

-- Kích hoạt Trident
local function ActivateTrident()
    if string.upper(tostring(Riptide)) == "ON" then
        RiptideTrident()
    else
        ThrowTrident()
    end
end

-- Kết nối Công cụ
tool.Equipped:Connect(addAsset)
tool.Unequipped:Connect(removeAsset)

tool.Activated:Connect(function()
    ActivateTrident()
end)
