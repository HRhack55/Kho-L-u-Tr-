-- TNT ở giữa
local Center_Count = TNT_Per_Ring[0] or 0

if Center_Count > 0 then
    for i = 1, Center_Count do
        CreateTNT(Center)
    end
end

-- Các vòng TNT
for Ring = 1, TNT_Max_Ring do
    local TNT_Count = TNT_Per_Ring[Ring] or 0

    -- Chỉ hoạt động khi số TNT lớn hơn 0
    if TNT_Count > 0 then
        local Radius = Ring * TNT_Ring_Distance

        for i = 1, TNT_Count do
            local Angle = (i - 1) * (math.pi * 2 / TNT_Count)

            local X = math.cos(Angle) * Radius
            local Z = math.sin(Angle) * Radius

            CreateTNT(Center + Vector3.new(X, 0, Z))
        end
    end
end





