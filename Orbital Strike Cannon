-- Người chơi
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

-- Cài đặt
local TNT_Time = 4                                                    -- Thời gian TNT tồn tại
local TNT_Texture_BlinkTime = 0.5                        -- Tốc độ chớp của texture
local TNT_Fling_Force = 0                                 -- Lực Fling khi TNT nổ, 0 = tắt
local TNT_Fling_Radius = 4                                 -- Bán kính Fling

-- TNT
local TNT = Instance.new("Part")
TNT.Name = "TNT"
TNT.Size = Vector3.new(4, 4, 4)
TNT.Color = Color3.fromRGB(255, 255, 255)
