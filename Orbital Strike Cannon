-- Tạo dây câu
local function CreateFishingLine()
    local Character = player.Character
    if not Character then return end

    local RightArm =
        Character:FindFirstChild("RightHand")
        or Character:FindFirstChild("Right Arm")
        or Character:FindFirstChild("RightUpperArm")

    if not RightArm then return end

    -- Tạo móc câu
    if not Hook then
        Hook = Instance.new("Part")
        Hook.Name = "FishingHook"
        Hook.Size = Vector3.new(0.2, 0.2, 0.2)
        Hook.Shape = Enum.PartType.Ball
        Hook.Color = Color3.fromRGB(180, 180, 180)
        Hook.Material = Enum.Material.Metal
        Hook.CanCollide = false
        Hook.CanTouch = false
        Hook.CanQuery = false
        Hook.Anchored = true
        Hook.Parent = workspace
    end

    -- Xóa dây cũ
    for _, Beam in ipairs(RopeBeams) do
        if Beam then
            Beam:Destroy()
        end
    end

    for _, Node in ipairs(RopeNodes) do
        if Node then
            Node:Destroy()
        end
    end

    table.clear(RopeBeams)
    table.clear(RopeNodes)

    -- Tạo các điểm dây
    for i = 1, RopeSegmentCount + 1 do
        local Node = Instance.new("Part")
        Node.Name = "RopePoint_" .. i
        Node.Size = Vector3.new(0.05, 0.05, 0.05)
        Node.Transparency = 1
        Node.Anchored = true
        Node.CanCollide = false
        Node.CanTouch = false
        Node.CanQuery = false
        Node.Parent = workspace

        local Attachment = Instance.new("Attachment")
        Attachment.Parent = Node

        RopeNodes[i] = Node
    end

    -- Tạo từng đoạn dây
    for i = 1, RopeSegmentCount do
        local Beam = Instance.new("Beam")

        Beam.Name = "FishingLine_" .. i
        Beam.Attachment0 = RopeNodes[i].Attachment
        Beam.Attachment1 = RopeNodes[i + 1].Attachment
        Beam.Width0 = 0.018
        Beam.Width1 = 0.018
        Beam.Color = ColorSequence.new(
            Color3.fromRGB(25, 25, 25)
        )
        Beam.Transparency = NumberSequence.new(0)
        Beam.FaceCamera = true
        Beam.LightEmission = 0
        Beam.LightInfluence = 1
        Beam.Segments = 2
        Beam.Parent = RopeNodes[i]

        RopeBeams[i] = Beam
    end

    -- Cập nhật dây
    if RopeUpdateConnection then
        RopeUpdateConnection:Disconnect()
    end

    RopeUpdateConnection =
        RunService.RenderStepped:Connect(function()

            if not Hook or not Hook.Parent then
                return
            end

            local CurrentCharacter =
                player.Character

            if not CurrentCharacter then
                return
            end

            local CurrentRightArm =
                CurrentCharacter:FindFirstChild("RightHand")
                or CurrentCharacter:FindFirstChild("Right Arm")
                or CurrentCharacter:FindFirstChild("RightUpperArm")

            if not CurrentRightArm then
                return
            end

            -- Điểm đầu dây bám theo cần/tay
            local StartPosition =
                CurrentRightArm.CFrame:PointToWorldSpace(
                    RopePosition
                )

            -- Móc giữ nguyên vị trí world
            local EndPosition =
                Hook.Position

            local Distance =
                (EndPosition - StartPosition).Magnitude

            -- Độ võng nhẹ kiểu dây câu
            local Sag =
                math.clamp(
                    Distance * 0.08,
                    0,
                    3
                )

            for i = 1, #RopeNodes do

                local T =
                    (i - 1) / RopeSegmentCount

                local NodePosition =
                    StartPosition:Lerp(
                        EndPosition,
                        T
                    )

                -- Võng nhẹ xuống
                local SagAmount =
                    4 * T * (1 - T)

                NodePosition -=
                    Vector3.new(
                        0,
                        Sag * SagAmount,
                        0
                    )

                RopeNodes[i].Position =
                    NodePosition
            end
        end)
end

-- Quăng móc câu
local function ThrowHook()

    if IsThrowing then
        return
    end

    local Character =
        player.Character

    if not Character then
        return
    end

    local RightArm =
        Character:FindFirstChild("RightHand")
        or Character:FindFirstChild("Right Arm")
        or Character:FindFirstChild("RightUpperArm")

    if not RightArm then
        return
    end

    CreateFishingLine()

    IsThrowing = true

    -- Điểm cast ban đầu
    local StartPosition =
        RightArm.CFrame:PointToWorldSpace(
            RopePosition
        )

    local TargetPosition =
        Mouse.Hit.Position

    -- Giới hạn khoảng cách
    local Direction =
        TargetPosition - StartPosition

    local Distance =
        Direction.Magnitude

    if Distance > RopeLimit then
        TargetPosition =
            StartPosition
            + Direction.Unit * RopeLimit
    end

    -- Hướng quăng
    local DirectionToTarget =
        (TargetPosition - StartPosition).Unit

    local Velocity =
        DirectionToTarget * ThrowSpeed

    local CurrentPosition =
        StartPosition

    Hook.Position =
        CurrentPosition

    -- Raycast
    local RaycastParams =
        RaycastParams.new()

    RaycastParams.FilterType =
        Enum.RaycastFilterType.Exclude

    RaycastParams.FilterDescendantsInstances = {
        Character,
        Hook
    }

    if PhysicsConnection then
        PhysicsConnection:Disconnect()
    end

    PhysicsConnection =
        RunService.Heartbeat:Connect(function(
            DeltaTime
        )

            if not Hook or not Hook.Parent then

                PhysicsConnection:Disconnect()
                PhysicsConnection = nil

                return
            end

            local PreviousPosition =
                CurrentPosition

            -- Trọng lực
            Velocity +=
                Vector3.new(
                    0,
                    -Gravity,
                    0
                ) * DeltaTime

            -- Di chuyển móc
            CurrentPosition +=
                Velocity * DeltaTime

            -- Raycast
            local RayDirection =
                CurrentPosition
                - PreviousPosition

            local Hit =
                workspace:Raycast(
                    PreviousPosition,
                    RayDirection,
                    RaycastParams
                )

            if Hit then

                CurrentPosition =
                    Hit.Position

                Hook.Position =
                    CurrentPosition

                IsThrowing = false

                PhysicsConnection:Disconnect()
                PhysicsConnection = nil

                return
            end

            -- Giới hạn dây
            local DistanceFromHand =
                (
                    CurrentPosition
                    - StartPosition
                ).Magnitude

            if DistanceFromHand >= RopeLimit then

                local DirectionFromHand =
                    (
                        CurrentPosition
                        - StartPosition
                    ).Unit

                CurrentPosition =
                    StartPosition
                    + DirectionFromHand
                    * RopeLimit

                Hook.Position =
                    CurrentPosition

                IsThrowing = false

                PhysicsConnection:Disconnect()
                PhysicsConnection = nil

                return
            end

            Hook.Position =
                CurrentPosition
        end)
end

-- Tạo TNT
local function CreateTNT(TNTPosition, character, root)

    local TNT = Instance.new("Part")
    TNT.Name = "TNT"
    TNT.Size = Vector3.new(4, 4, 4)
    TNT.Color = Color3.fromRGB(255, 255, 255)
    TNT.Material = Enum.Material.Neon
    TNT.Anchored = false
    TNT.CanCollide = true
    TNT.Position = TNTPosition
    TNT.Parent = workspace

    -- Âm thanh xì
    local TNT_Hiss = Instance.new("Sound")
    TNT_Hiss.SoundId = "rbxassetid://4633141679"
    TNT_Hiss.Volume = 1
    TNT_Hiss.Parent = TNT
    TNT_Hiss:Play()

    -- Âm thanh nổ
    local TNT_ExplosionSound = Instance.new("Sound")
    TNT_ExplosionSound.SoundId = "rbxassetid://112343351840629"
    TNT_ExplosionSound.Volume = 1

    -- Kết cấu
    local AroundTexture = Instance.new("Texture")
    AroundTexture.Texture = "rbxassetid://5522032314"
    AroundTexture.Face = Enum.NormalId.Front
    AroundTexture.StudsPerTileU = TNT.Size.X
    AroundTexture.StudsPerTileV = TNT.Size.Y
    AroundTexture.Parent = TNT

    local AroundTexture2 = AroundTexture:Clone()
    AroundTexture2.Face = Enum.NormalId.Back
    AroundTexture2.Parent = TNT

    local AroundTexture3 = AroundTexture:Clone()
    AroundTexture3.Face = Enum.NormalId.Left
    AroundTexture3.StudsPerTileU = TNT.Size.Z
    AroundTexture3.StudsPerTileV = TNT.Size.Y
    AroundTexture3.Parent = TNT

    local AroundTexture4 = AroundTexture:Clone()
    AroundTexture4.Face = Enum.NormalId.Right
    AroundTexture4.StudsPerTileU = TNT.Size.Z
    AroundTexture4.StudsPerTileV = TNT.Size.Y
    AroundTexture4.Parent = TNT

    local TopTexture = Instance.new("Texture")
    TopTexture.Texture = "rbxassetid://5522034026"
    TopTexture.Face = Enum.NormalId.Top
    TopTexture.StudsPerTileU = TNT.Size.X
    TopTexture.StudsPerTileV = TNT.Size.Z
    TopTexture.Parent = TNT

    local BottomTexture = Instance.new("Texture")
    BottomTexture.Texture = "rbxassetid://124194880868071"
    BottomTexture.Face = Enum.NormalId.Bottom
    BottomTexture.StudsPerTileU = TNT.Size.X
    BottomTexture.StudsPerTileV = TNT.Size.Z
    BottomTexture.Parent = TNT

    -- Nhấp nháy Texture
    task.spawn(function()

        local StartTime = tick()
        local TextureVisible = true

        while TNT.Parent and tick() - StartTime < TNT_Time do

            TextureVisible =
                not TextureVisible

            AroundTexture.Transparency =
                TextureVisible and 0 or 1

            AroundTexture2.Transparency =
                TextureVisible and 0 or 1

            AroundTexture3.Transparency =
                TextureVisible and 0 or 1

            AroundTexture4.Transparency =
                TextureVisible and 0 or 1

            TopTexture.Transparency =
                TextureVisible and 0 or 1

            BottomTexture.Transparency =
                TextureVisible and 0 or 1

            task.wait(TNT_Texture_BlinkTime)
        end
    end)

    -- Thời gian nổ
    task.delay(TNT_Time, function()

        if TNT.Parent then

            local ExplosionSound =
                TNT_ExplosionSound:Clone()

            ExplosionSound.Parent =
                SoundService

            ExplosionSound:Play()

            local Explosion =
                Instance.new("Explosion")

            Explosion.Position =
                TNT.Position

            Explosion.BlastRadius =
                0

            Explosion.BlastPressure =
                0

            Explosion.DestroyJointRadiusPercent =
                0

            Explosion.Parent =
                workspace

            -- Fling khi TNT nổ
            if TNT_Fling_Force > 0
                and character.Parent
                and root.Parent then

                local Distance =
                    (root.Position - TNT.Position).Magnitude

                if Distance <= TNT_Fling_Radius then

                    local Direction =
                        root.Position - TNT.Position

                    if Direction.Magnitude > 0 then

                        Direction =
                            Direction.Unit

                        root.AssemblyLinearVelocity =
                            root.AssemblyLinearVelocity
                            + Direction * TNT_Fling_Force
                    end
                end
            end

            TNT:Destroy()

            ExplosionSound.Ended:Connect(function()
                ExplosionSound:Destroy()
            end)
        end
    end)
end

